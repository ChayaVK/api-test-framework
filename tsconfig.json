{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "config/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "learn/**/*.ts"
  ]
}
